{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ormanipomeri-dev",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": { "enabled": true },
  // This Worker's database is a copy of production. In this mode every email
  // goes to the EMAIL_REDIRECT_TO secret instead of its real recipient, and
  // none are sent without it. The production Worker must not set it.
  "vars": { "EMAIL_MODE": "redirect" },
  // Neon branch "dev". Query caching is off: an admin edit must show up in
  // the very next read. Local dev reads the connection string from
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE in .env.
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "6e574ae7840d4de893cbf0f5300bc102" }
  ],
  // The production site: `npm run deploy:production`. It has its own
  // database binding and no EMAIL_MODE, so email goes to its real recipients.
  // (Bindings and vars are not inherited from the top level.)
  "env": {
    "production": {
      "name": "ormanipomeri",
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "5c4849265254430d810c4b49e3d08b00" }
      ]
    }
  }
}
